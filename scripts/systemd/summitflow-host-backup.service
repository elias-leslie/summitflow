[Unit]
Description=SummitFlow host backup: btrbk points every 4 hours, one daily Google Drive copy
After=network-online.target
Wants=network-online.target
ConditionPathExists=%h/.summitflow/services/projects/summitflow/current/source/backend/.venv/bin/python

[Service]
Type=oneshot
WorkingDirectory=%h/.summitflow/services/projects/summitflow/current/source/backend
Environment="PATH=%h/.local/bin:%h/.summitflow/services/projects/summitflow/current/source/backend/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HOME=%h"
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=-%h/.env.local
EnvironmentFile=-%h/.config/summitflow/backup-schedule.env
# Not while the machine is thrashing: the next scheduled run does the work. A skipped run is not a failure.
ExecCondition=/bin/sh -c 'awk '\''$1=="some"{s=substr($3,7)} $1=="full"{f=substr($3,7)} END{exit !(s+0<25 && f+0<10)}'\'' /proc/pressure/memory'
ExecStart=%h/.summitflow/services/projects/summitflow/current/source/backend/.venv/bin/python -m app.tasks.backup_run
# The desktop always wins: lowest CPU and disk priority, bounded memory (restic's pack spool lives in the user
# tmpfs and counts here; its metadata cache is on /srv/scratch, capped), and a hard stop so a hung run is
# killed and the next scheduled run starts clean.
Nice=19
IOSchedulingClass=idle
CPUWeight=10
MemoryHigh=3G
MemoryMax=6G
TimeoutStartSec=12h
KillMode=control-group
KillSignal=SIGINT
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=summitflow-host-backup
