[Unit]
Description=Monthly Btrfs data and metadata checksum scrub of /srv/workspaces
ConditionPathIsMountPoint=/srv/workspaces
After=local-fs.target

[Service]
Type=oneshot
# Shared lock with the other scrub units so scrubs never overlap.
ExecStart=/usr/bin/flock /run/lock/summitflow-btrfs-scrub.lock /usr/bin/btrfs scrub start -Bd -c 3 /srv/workspaces
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=6h
StandardOutput=journal
StandardError=journal
