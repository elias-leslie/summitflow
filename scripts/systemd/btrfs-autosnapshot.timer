[Unit]
Description=Run Btrfs autosnapshot sweep every thirty minutes

[Timer]
# Wall-clock schedule: monotonic OnBootSec/OnUnitActiveSec triggers left this
# timer with no next elapse after a reboot. Persistent catches up a missed slot.
OnCalendar=*:0/30
RandomizedDelaySec=2min
Persistent=true
Unit=btrfs-autosnapshot.service

[Install]
WantedBy=timers.target
