[Unit]
Description=SummitFlow: retry managed Codex outboxes through Agent Hub
After=network.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.env.local
ExecStart=__SUMMITFLOW_ROOT__/backend/.venv/bin/python __SUMMITFLOW_ROOT__/scripts/codex-managed-drain.py
StandardOutput=journal
StandardError=journal
