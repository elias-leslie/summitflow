[Unit]
Description=SummitFlow system host monitor
After=local-fs.target

[Service]
Type=simple
# Runs as root without an explicit User=: with User= set, systemd withholds
# CAP_SETUID under NoNewPrivileges+seccomp, and the collector needs it to read
# the owner's user manager as the owner instead of opening a PAM session.
WorkingDirectory=__MONITOR_RELEASE__
Environment="PATH=/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=__MONITOR_RELEASE__/summitflow-host-monitor --state-dir /var/lib/summitflow/monitor --project-identity __MONITOR_RELEASE__/project.identity.json --policy-snapshot __MONITOR_RELEASE__/policy.json --owner-uid __MONITOR_OWNER_UID__ --owner-gid __MONITOR_OWNER_GID__ --observe-helper __MONITOR_RELEASE__/monitor-observe.pyz
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/summitflow/monitor
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
StandardOutput=journal
StandardError=journal
SyslogIdentifier=summitflow-host-monitor

[Install]
WantedBy=multi-user.target
