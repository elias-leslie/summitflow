[Unit]
Description=Codex Transcript Sync to Agent Hub
After=network.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.env.local
ExecStart=__SUMMITFLOW_ROOT__/backend/.venv/bin/python __SUMMITFLOW_ROOT__/scripts/codex-session-sync.py --scan --close-inactive
StandardOutput=journal
StandardError=journal
