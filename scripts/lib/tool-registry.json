  "description": "Centralized tool registry — single source of truth for operator tool discovery, redirects, and check-runner configuration.",
  "cmd_start": "(^|&&\\s*|;\\s*)",
  "operator_tools": [
    {
      "id": "service",
      "canonical": "st service",
      "replaces": [
        "rebuild.sh",
        "status.sh",
        "start.sh",
        "restart.sh",
        "shutdown.sh"
      ],
      "summary": "Project service lifecycle, rebuild, migrations, systemd sync, and health checks.",
      "safety": "mutating",
      "commands": [
        "status",
        "rebuild",
        "restart",
        "start",
        "stop"
      ],
      "examples": [
        "st service status summitflow",
        "st service rebuild summitflow",
        "st service stop"
      ],
      "verify": [
        "st service status summitflow"
      ]
    },
    {
      "id": "check",
      "canonical": "st check",
      "replaces": [
        "dt",
        "dev-tools.sh"
      ],
      "summary": "Quality gates and tool wrappers with TOON output.",
      "safety": "read-mostly",
      "commands": [
        "--check",
        "--quick",
        "cleanroom",
        "codeql",
        "pytest",
        "ruff",
        "types",
        "biome",
        "tsc",
        "vitest",
        "actionlint",
        "shellcheck",
        "govulncheck"
      ],
      "examples": [
        "st check --quick --changed-only",
        "st check codeql",
        "st check cleanroom -- bash scripts/install.sh --skip-systemd",
        "st check pytest -- backend/tests/cli/test_tools_cli.py"
      ],
      "verify": [
        "st check --help"
      ]
    },
    {
      "id": "graph",
      "canonical": "st graph",
      "replaces": [
        "graphify",
        "fallow"
      ],
      "summary": "Graphify topology, auto-refresh diagnostics, and compact Fallow JS/TS audits.",
      "safety": "read-mostly",
      "commands": [
        "status",
        "doctor",
        "refresh",
        "query",
        "path",
        "explain",
        "fallow",
        "profile"
      ],
      "examples": [
        "st graph doctor --project summitflow",
        "st graph query \"auth topology\" --project summitflow",
        "st graph fallow audit --project summitflow"
      ],
      "verify": [
        "st graph doctor --project summitflow"
      ]
    },
    {
      "id": "task_workflow",
      "canonical": "st pulse / st claim / st context / st done",
      "replaces": [
        "manual task branch setup",
        "st tasks claim"
      ],
      "summary": "Task lifecycle workflow: inspect coordination gate, claim task checkpoint, read context, and close completed task.",
      "safety": "mutating",
      "commands": [
        "pulse --gate",
        "claim <task-id>",
        "context <task-id>",
        "subtask list <task-id>",
        "done <subtask-id> -t <task-id> --none",
        "done <task-id>"
      ],
      "examples": [
        "st pulse --gate",
        "st claim task-abc123",
        "st context task-abc123",
        "st done task-abc123 -m \"complete\""
      ],
      "verify": [
        "st claim --help",
        "st done --help"
      ]
    },
    {
      "id": "db",
      "canonical": "st db",
      "replaces": [
        "db"
      ],
      "summary": "Cross-project PostgreSQL inspection and Alembic migration operations.",
      "safety": "mixed",
      "commands": [
        "tables",
        "schema",
        "count",
        "sample",
        "query",
        "exec",
        "ddl",
        "migrate"
      ],
      "examples": [
        "st db tables",
        "st db migrate status"
      ],
      "verify": [
        "st db tables"
      ]
    },
    {
      "id": "vcs",
      "canonical": "st done / st commit / st jj / st git",
      "replaces": [
        "commit.sh"
      ],
      "summary": "Version-control workflow: st done for task closeout; st commit and st jj for blockers/checkpoints; st git only for inspection and residue repair.",
      "safety": "mutating",
      "commands": [
        "done",
        "commit",
        "jj",
        "git status",
        "git sync",
        "git resolve-conflict"
      ],
      "examples": [
        "st done task-abc123 -m \"complete\"",
        "st commit --message \"checkpoint\" --push",
        "st jj status",
        "st git status"
      ],
      "verify": [
        "st git status"
      ]
    },
    {
      "id": "browser",
      "canonical": "st browser",
      "replaces": [],
      "summary": "Remote browser health, responsive checks, screenshots, snapshots, and DOM evaluation.",
      "safety": "external",
      "commands": [
        "health",
        "check",
        "open",
        "screenshot",
        "snapshot",
        "eval"
      ],
      "examples": [
        "st browser health",
        "st browser check http://localhost:3001 /tmp/summitflow.png"
      ],
      "verify": [
        "st browser health"
      ]
    },
    {
      "id": "web",
      "canonical": "st web",
      "replaces": [
        "web-research"
      ],
      "summary": "Centralized public web search, research, and fetch through Agent Hub.",
      "safety": "external",
      "commands": [
        "search",
        "research",
        "fetch"
      ],
      "examples": [
        "st web search --query \"SummitFlow\" --limit 1"
      ],
      "verify": [
        "st web --help"
      ]
    },
    {
      "id": "backup",
      "canonical": "st backup",
      "replaces": [
        "backup.sh",
        "restore.sh",
        "backup-all.sh",
        "backup-pending-upload.sh"
      ],
      "summary": "Project/source backup creation, restore preview, schedules, pending drain, and infra backups.",
      "safety": "destructive-with-confirmation",
      "commands": [
        "list",
        "create",
        "restore",
        "archives",
        "all",
        "status",
        "delete",
        "drain-pending",
        "infra",
        "storage",
        "testbed"
      ],
      "examples": [
        "st backup status",
        "st backup archives",
        "st backup restore bkp-123 --dry-run"
      ],
      "verify": [
        "st backup status"
      ]
    },
    {
      "id": "vm",
      "canonical": "st vm",
      "replaces": [
        "proxmox-vm.sh"
      ],
      "summary": "Proxmox test VM list/status/snapshot/rollback/clone/start/stop/destroy/ip.",
      "safety": "destructive-with-confirmation",
      "commands": [
        "list",
        "status",
        "snapshots",
        "snapshot",
        "rollback",
        "clone",
        "start",
        "stop",
        "destroy",
        "ip"
      ],
      "examples": [
        "st vm list",
        "st vm status 100"
      ],
      "verify": [
        "st vm --help"
      ]
    },
    {
      "id": "setup",
      "canonical": "st setup",
      "replaces": [
        "setup-services.sh",
        "setup-agent-browser.sh",
        "setup-agent-tooling.sh",
        "setup-test-dbs.sh"
      ],
      "summary": "Install, PATH, browser, agent tooling, and test database setup.",
      "safety": "mutating",
      "commands": [
        "services",
        "browser",
        "agent-tooling",
        "test-dbs"
      ],
      "examples": [
        "st setup services --dry-run",
        "st setup browser --dry-run"
      ],
      "verify": [
        "st setup --help"
      ]
    },
    {
      "id": "ui",
      "canonical": "st ui",
      "replaces": [
        "scrot",
        "import",
        "tesseract",
        "wmctrl",
        "xdotool",
        "ydotool",
        "xclip",
        "compare"
      ],
      "summary": "Desktop UI control on X11: list windows, screenshot, OCR, image diff, window move/resize/activate/close, click/type/key, and clipboard. TOON-compact output. Use to self-verify GUI changes.",
      "safety": "mutating",
      "commands": [
        "windows",
        "shot",
        "ocr",
        "diff",
        "activate",
        "move",
        "resize",
        "close",
        "click",
        "type",
        "key",
        "clip"
      ],
      "examples": [
        "st ui windows",
        "st ui shot -w summitflow -o /tmp/summitflow.png",
        "st ui ocr summitflow",
        "st ui diff a.png b.png"
      ],
      "verify": [
        "st ui windows"
      ]
    }
  ],
  "wrapper_allowlist": [
    "st\\b",
    "st\\s+docker\\b"
  ],
  "tools": [
    {
      "name": "actionlint",
      "component_id": "sf.check",
      "redirect_patterns": [],
      "redirect_message": "Use 'st check actionlint' for scoped quality checks.",
      "check": {
        "label": "ACTIONLINT",
        "binary": "actionlint",
        "args": "",
        "working_dir": "root",
        "fallback_global": true,
        "pass_path": false
      }
    },
    {
      "name": "shellcheck",
      "component_id": "sf.check",
      "redirect_patterns": [],
      "redirect_message": "Use 'st check shellcheck' for scoped quality checks.",
      "check": {
        "label": "SHELLCHECK",
        "binary": "shellcheck",
        "args": "",
        "working_dir": "root",
        "fallback_global": true,
        "pass_path": false
      }
    },
    {
      "name": "govulncheck",
      "component_id": "sf.check",
      "redirect_patterns": [],
      "redirect_message": "Use 'st check govulncheck' for scoped quality checks.",
      "check": {
        "label": "GOVULNCHECK",
        "binary": "govulncheck",
        "args": "",
        "working_dir": "root",
        "fallback_global": true,
        "pass_path": false
      }
    },
    {
      "name": "pytest",
      "component_id": "sf.check",
      "redirect_patterns": [
        "([^\\s]*/)?\\.venv/bin/pytest\\b",
        "pytest\\b",
        "python[0-9.]*\\s+-m\\s+pytest\\b",
        "([^\\s]*/)?\\.venv/bin/python.*-m\\s+pytest\\b"
      ],
      "redirect_message": "Use 'st check pytest [args]' — handles venv, TOON output, and project resolution.",
      "check": {
        "label": "TEST",
        "binary": "pytest",
        "args": "--tb=short -q",
        "count_method": "pytest_parse",
        "working_dir": "test",
        "fallback_global": false,
        "pass_path": false
      }
    },
    {
      "name": "types",
      "component_id": "sf.check",
      "redirect_patterns": [
        "(\\.venv/bin/)?mypy\\b",
        "(\\.venv/bin/)?\\bty\\b"
      ],
      "redirect_message": "Use 'st check types [args]' — handles venv, TOON output, and project resolution.",
      "check": {
        "label": "TYPES",
        "binary": "ty",
        "args": "check --output-format concise",
        "count_method": "grep_error",
        "working_dir": "backend",
        "fallback_global": true,
        "pass_path": true
      }
    },
    {
      "name": "ruff",
      "component_id": "sf.check",
      "redirect_patterns": [
        "(\\.venv/bin/)?ruff\\b"
      ],
      "redirect_message": "Use 'st check ruff [args]' — handles venv, TOON output, and project resolution.",
      "check": {
        "label": "LINT",
        "binary": "ruff",
        "args": "check --output-format=concise",
        "count_method": "wc_l",
        "working_dir": "backend",
        "fallback_global": true,
        "pass_path": true
      }
    },
    {
      "name": "biome",
      "component_id": "sf.check",
      "redirect_patterns": [
        "(npx\\s+)?biome\\b"
      ],
      "redirect_message": "Use 'st check biome [args]' — handles TOON output and project detection.",
      "check": {
        "label": "BIOME",
        "binary": "npx",
        "args": "biome check . --max-diagnostics=100 --no-errors-on-unmatched",
        "count_method": "biome_parse",
        "working_dir": "frontend",
        "fallback_global": true,
        "pass_path": true
      }
