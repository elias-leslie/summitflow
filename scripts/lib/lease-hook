#!/usr/bin/env bash
# Coordination hook for every harness (Claude Code, Codex, Pi extension). Not a
# safety gate: any internal error or timeout fails open (exit 0, one stderr line).
#   lease-hook            PreToolUse edit: auto-lease and join the file's writer set; exit 2 + one line on a
#                         live collision
#   lease-hook session    SessionStart: register identity; one stdout line if a reset left work open
#   lease-hook bash-pre   PreToolUse shell: snapshot the dirty files of the cwd repo and of sibling repos
#                         the command names (pure shell)
#   lease-hook bash-post  PostToolUse(Failure) shell: record written/deleted paths in writer sets (other repos
#                         and background commands as unknown); one warning line if the command wrote a
#                         foreign-leased file; one additionalContext line when a gh/git push error shows
#                         GitHub's fine-grained-PAT 403
# Silent when nothing overlaps. Bypass: ALLOW_LEASE_OVERLAP=1 (lease checks only).
mode="${1:-edit}"
input=$(cat)
export LC_ALL=C
sf="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/../.." && pwd)"
py="$sf/backend/.venv/bin/python"
hint=""
if [ "$mode" = bash-post ] && [ -x "$py" ]; then
    # Pure-shell substring prefilter: no cost when absent. Python then requires the command to run
    # gh/git push and the phrase to sit in the tool's error output, not quoted text such as a commit message.
    case "$input" in *"Resource not accessible by personal access token"*)
        if event=$(timeout 2 env PYTHONPATH="$sf/backend" "$py" -I -c '
import json, sys
sys.path.insert(0, sys.argv[1])
from cli.lib.coord import github_pat_denied_event
event = github_pat_denied_event(json.loads(sys.stdin.read() or "{}"))
print(event or "")
sys.exit(0 if event in ("PostToolUse", "PostToolUseFailure") else 1)' "$sf/backend" <<<"$input" 2>/dev/null); then
            hint="GitHub 403 (gh PAT lacks admin scope): get an owner-approved 30-min grant with nightshift elevate request github-admin --reason '<what, in owner words>' --wait, then nightshift elevate run github-admin -- gh ...; never print the credential."
            printf '{"hookSpecificOutput":{"hookEventName":"%s","additionalContext":"%s"}}\n' "$event" "$hint"
        fi ;;
    esac
fi
[ "${ALLOW_LEASE_OVERLAP:-0}" = "1" ] && exit 0
# Diagnostics: ST_COORD_HOOK_TRACE=<file> appends each mode and payload.
[ -n "${ST_COORD_HOOK_TRACE:-}" ] && printf '%s %s\n' "$mode" "$input" >>"$ST_COORD_HOOK_TRACE" 2>/dev/null

snapshot() {  # "<mtime_ns> <abs path>" per dirty file of repo $1, "D <abs path>" per deleted path
    local top=$1 rec src
    local -a present=()
    while IFS= read -r -d '' rec; do
        case "$rec" in
            R*) IFS= read -r -d '' src; [ -e "$top/$src" ] || [ -L "$top/$src" ] || printf 'D %s\n' "$top/$src" ;;
            C*) IFS= read -r -d '' src ;;
        esac
        rec=${rec:3}
        [ -n "$rec" ] || continue
        if [ -e "$top/$rec" ] || [ -L "$top/$rec" ]; then present+=("$top/$rec"); else printf 'D %s\n' "$top/$rec"; fi
    done < <(git -C "$top" status --porcelain=v1 -z --untracked-files=all 2>/dev/null)
    [ ${#present[@]} -eq 0 ] || printf '%s\0' "${present[@]}" | xargs -0 -r stat -c '%.9Y %n' 2>/dev/null
}
field() {  # top-level JSON string value of key $1 (pure shell); exit 1 when absent or escaped
    local re="\"$1\"[[:space:]]*:[[:space:]]*\"([^\"]*)\""
    [[ $input =~ $re ]] || return 1
    case "${BASH_REMATCH[1]}" in *\\*) return 1 ;; esac
    printf '%s' "${BASH_REMATCH[1]}"
}
[ -x "$py" ] || { echo "lease-hook: summitflow venv unavailable; allowing" >&2; exit 0; }
if [ "$mode" = bash-pre ] || [ "$mode" = bash-post ]; then
    # Pure shell on the hot path (no Python start per command); Python only when a value is escaped.
    if sid=$(field session_id) && cwd=$(field cwd); then
        tid=$(field tool_use_id) || tid=$(field toolCallId) || tid=""
        key="$sid-$tid"
    else
        { IFS= read -r key; IFS= read -r cwd; } < <("$py" -I -c '
import json, sys
d = json.loads(sys.stdin.read() or "{}")
print("%s-%s" % (d.get("session_id") or "", d.get("tool_use_id") or d.get("toolCallId") or ""))
print(d.get("cwd") or "")' <<<"$input" 2>/dev/null)
    fi
    key=$(printf '%s' "$key" | tr -c 'A-Za-z0-9_.-' '_')
    [ -n "$cwd" ] && [ -n "$key" ] || exit 0
    dir="${XDG_RUNTIME_DIR:-/tmp}/st-lease-bash"
    mkdir -p "$dir" 2>/dev/null || exit 0
    if [ "$mode" = bash-pre ]; then
        top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || top=""
        tops=()
        if [ -n "$top" ]; then
            tops=("$top")
            # Sibling repos the command names by absolute path (cd /x/other, git -C /x/other): writes there are unknown.
            parent=${top%/*}
            pat=$(printf '%s' "$parent" | sed 's/[][\.*^$]/\\&/g')
            while IFS= read -r other; do
                [ "$other" != "$top" ] && [ -e "$other/.git" ] && tops+=("$other")
            done < <(grep -o "$pat/[A-Za-z0-9._-]\+" <<<"$input" 2>/dev/null | sort -u)
        fi
        bg=0
        [[ $input =~ \"run_in_background\"[[:space:]]*:[[:space:]]*true ]] && bg=1
        {
            date -u +%Y-%m-%dT%H:%M:%S.%6N+00:00
            printf '%s %s\n' "$bg" "${#tops[@]}"
            [ ${#tops[@]} -eq 0 ] || printf '%s\n' "${tops[@]}"
            for t in "${tops[@]}"; do snapshot "$t"; done | sort
        } >"$dir/$key" 2>/dev/null
        find "$dir" -maxdepth 1 -type f -mmin +120 -delete 2>/dev/null
        exit 0
    fi
    [ -f "$dir/$key" ] || exit 0
    { IFS= read -r since; read -r bg ntops; } <"$dir/$key"
    case "$ntops" in ''|*[!0-9]*) ntops=0 ;; esac
    mapfile -t tops < <(sed -n "3,$((ntops + 2))p" "$dir/$key")
    after=$(for t in "${tops[@]}"; do snapshot "$t"; done | sort)
    written=$(comm -13 <(tail -n +$((ntops + 3)) "$dir/$key") <(printf '%s\n' "$after" | grep -v '^$') | cut -d' ' -f2-)
    rm -f "$dir/$key"
    [ -n "$written" ] || exit 0
    top=${tops[0]} own="" other="" dirty=""
    while IFS= read -r line; do
        case "$line" in "$top/"*) own+="$line"$'\n' ;; ?*) other+="$line"$'\n' ;; esac
    done <<<"$written"
    while IFS= read -r line; do
        line=${line#* }
        case "$line" in "$top/"*) dirty+="$line"$'\n' ;; esac
    done <<<"$after"
    export ST_HOOK_SINCE="$since" ST_HOOK_WRITTEN="$own" ST_HOOK_OTHER="$other" ST_HOOK_BG="$bg"
    # The whole dirty set goes by file: it can outgrow the environment.
    dirty_file=$(mktemp "$dir/.dirty.XXXXXX" 2>/dev/null) && printf '%s' "$dirty" >"$dirty_file" \
        && export ST_HOOK_DIRTY_FILE="$dirty_file"
fi
out=$(timeout 2 env PYTHONPATH="$sf/backend" "$py" -I -c '
import json, os, sys
sys.path.insert(0, sys.argv[1])
from cli.lib.coord import dispatch_hook
payload = json.loads(sys.stdin.read() or "{}")
if "ST_HOOK_WRITTEN" in os.environ:
    def lines(text):
        return [line for line in text.split("\n") if line]
    payload["st_since"] = os.environ.get("ST_HOOK_SINCE", "")
    payload["st_written"] = lines(os.environ["ST_HOOK_WRITTEN"])
    payload["st_other"] = lines(os.environ.get("ST_HOOK_OTHER", ""))
    payload["st_background"] = os.environ.get("ST_HOOK_BG") == "1"
    if os.environ.get("ST_HOOK_DIRTY_FILE"):
        try:
            with open(os.environ["ST_HOOK_DIRTY_FILE"]) as handle:
                payload["st_dirty"] = lines(handle.read())
        except OSError:
            pass
result = dispatch_hook(payload)
if result:
    kind, text = result
    if kind == "context":
        text = json.dumps({"hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": text}})
    print(text)
    sys.exit({"block": 3, "warn": 4, "context": 5}[kind])
' "$sf/backend" <<<"$input" 2>&1)
rc=$?
[ -z "${dirty_file:-}" ] || rm -f "$dirty_file"
case "$rc:$out" in
    3:BLOCKED*) printf '%s\n' "$out" >&2; exit 2 ;;
    4:OVERLAP*) printf '%s\n' "$out" >&2; [ -z "$hint" ] || printf '%s\n' "$hint" >&2; exit 2 ;;  # exit 2 drops stdout JSON
    5:\{*) printf '%s\n' "$out"; exit 0 ;;
    0:) exit 0 ;;
esac
echo "lease-hook: internal error rc=$rc; allowing" >&2
exit 0
